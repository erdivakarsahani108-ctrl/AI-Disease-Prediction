# Byte-compiled / cache
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.ipynb_checkpoints/

# Virtual environment
.venv/
venv/
env/

# Environment secrets
.env

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# Streamlit
.streamlit/secrets.toml

# Database (MySQL local dumps/credentials - never commit real data/secrets)
*.sql.bak
database/*.cnf
database/local_backup/

# Logs
*.log

# Temporary / scratch files
_tmp_*.py
*.tmp

# Large local-only artifacts (kept out of VCS; regenerate via scripts/)
# Uncomment if you don't want to commit trained artifacts/data:
# data/processed/
# models/*.pkl
