# Copy this file to `.env` and fill in values only if you enable optional
# features. The core application (dataset, ML prediction, NLP, dashboards)
# works fully WITHOUT any of these variables set.

# ---------------------------------------------------------------------------
# OPTIONAL: LLM integration (Future Scope - NOT required, NOT enabled by
# default). See docs/ai_transparency.md before enabling this in production.
# ---------------------------------------------------------------------------
# LLM_PROVIDER=openai
# LLM_API_KEY=your-api-key-here
# LLM_MODEL=gpt-4o-mini

# ---------------------------------------------------------------------------
# OPTIONAL: MLflow experiment tracking backend (Future Scope - a lightweight
# CSV-based tracker is used by default, see src/ml/experiment_tracker.py).
# ---------------------------------------------------------------------------
# MLFLOW_TRACKING_URI=http://localhost:5000

# ---------------------------------------------------------------------------
# OPTIONAL: Voice input speech-to-text API (Future Scope - not implemented).
# ---------------------------------------------------------------------------
# SPEECH_TO_TEXT_API_KEY=your-api-key-here

# ---------------------------------------------------------------------------
# OPTIONAL: MySQL database connection (Future Scope - see database/README.md
# and src/database/. NEVER put real credentials here or in any committed
# file - this .env.example only documents the expected variable NAMES).
# ---------------------------------------------------------------------------
# MYSQL_HOST=localhost
# MYSQL_PORT=3306
# MYSQL_DATABASE=disease_prediction_db
# MYSQL_USER=your-username-here
# MYSQL_PASSWORD=your-password-here

# ---------------------------------------------------------------------------
# App configuration
# ---------------------------------------------------------------------------
APP_ENV=development
RANDOM_SEED=42
